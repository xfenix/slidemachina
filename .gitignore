# Зависимости
node_modules/

# Сборки презентаций: slidemachina build кладёт их в dist/ рядом с index.tsx
dist/
*.tgz

# Кэш Vite, в том числе в папке без своего package.json
.vite/

# Результаты тестов Playwright
test-results/
playwright-report/
blob-report/
.playwright-mcp/

# Логи
*.log
npm-debug.log*

# Локальные настройки и секреты: пароль презентаций — в SLIDEMACHINA_PASSWORD
.env
.env.*
.npmrc

# Редакторы и система
.DS_Store
.idea/
.vscode/
*.swp
.serena/

# Пакеты для npm: .github/prepare-npm-packages.ts в CI кладёт рядом JavaScript, README и лицензию
packages/*/README.md
packages/*/LICENSE
packages/slidemachina/server-runtime/**/*.js
packages/slidemachina/shared-between-runtimes/*.js
packages/create-slidemachina/create-project.js
