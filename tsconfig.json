{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "slidemachina": ["./packages/slidemachina/browser-runtime/public-interface/slidemachina.ts"]
    }
  },
  "include": ["packages/slidemachina", "workspace-checks", "packages/create-slidemachina/*.ts", "examples", "tests", "playwright.config.ts"],
  "exclude": ["**/dist", "**/node_modules"]
}
