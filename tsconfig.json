{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "slidemachina": ["./src/slidemachina.ts"]
    }
  },
  "include": ["src", "bin", "create-slidemachina/*.js", "demo-presentation", "examples", "tests", "playwright.config.ts"]
}
